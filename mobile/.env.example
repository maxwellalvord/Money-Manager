# Copy this file to .env.local and fill in real values.

# Public Clerk key — safe to share, same value as the web app's
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in ../.env.local
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the Next.js app that serves app/api/v1/*.
# For local dev: your machine's LAN IP (not "localhost" — a physical device
# or Android emulator can't reach your computer's loopback address), e.g.
# http://192.168.1.23:3000. The iOS Simulator can use http://localhost:3000.
# For production: the deployed site's URL, e.g. https://your-app.vercel.app
EXPO_PUBLIC_API_URL=http://localhost:3000
